# Copy to .env for local `docker compose up` (repo root). Never commit the
# real .env — it's gitignored.
#
#   cp .env.example .env
#
# Fill in your own JWT_SECRET_KEY below (any 32+ char local value is fine —
# never reuse a production secret for local dev).

# --- Local Postgres (docker-compose's `postgres` service) ---
POSTGRES_USER=simple_bank
POSTGRES_PASSWORD=password
POSTGRES_DB=simple_bank

# --- core-service image to run ---
# Matches apps/core-service/Makefile's DEP_IMAGE_NAME. Override to pin a
# specific tag, e.g. sdewa/core-service-dep:<git-sha>.
CORE_SERVICE_IMAGE=sdewa/core-service-dep:latest

# --- core-service runtime config ---
# Full reference: apps/core-service/app.env.example
DB_DRIVER=postgres
DB_SOURCE=postgresql://simple_bank:password@postgres:5432/simple_bank?sslmode=disable
SERVER_ADDRESS=0.0.0.0:8080
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_DURATION=600m
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://simplebankportal.vercel.app
LOG_LEVEL=info
LOG_FORMAT=json
LOG_PRETTY_JSON=false
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
LOG_MAX_BODY_SIZE=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=5
RATE_LIMIT_BURST=20
# Dev-only: IPs exempt from the auth device-fingerprint binding check. Leave
# empty in any real environment.
DEVICE_FINGERPRINT_TRUSTED_IPS=

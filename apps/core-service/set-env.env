#!/bin/bash

set_env() {
    export DB_URI="postgresql://user:password@localhost:5432/simple_bank"

    echo "Environment variables set."
}

unset_env() {
    unset DB_URI

    echo "Environment variables removed."
}

case "$1" in
    set)
        set_env
        ;;
    unset|remove)
        unset_env
        ;;
    *)
        echo "Usage: source set-env.sh {set|unset}"
        ;;
esac